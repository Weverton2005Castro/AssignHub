# API
NEXT_PUBLIC_API_URL=http://localhost:4000

# App
NEXT_PUBLIC_APP_VERSION=0.1.0

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-nextauth-key-min-32-chars

# OAuth Providers (optional - can be configured in backend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=

# SEO: canonical origin (no path). Configure before the production build.
SITE_URL=https://seu-dominio.com.br
# Enable only on the public production deployment, never on previews/staging.
SEO_INDEXABLE=false
# Google Search Console HTML verification token (optional).
GOOGLE_SITE_VERIFICATION=
